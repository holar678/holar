# 会话和编辑器的本地配置
.claude/
.vscode/
.idea/

# 微信开发者工具的个人设置(每个人不一样,不进仓库)
project.private.config.json

# 美术处理过程中的临时文件
art_raw/_测试样例/
art_raw/_检查图.png
art_raw/_检查图_界面.png

# 美术原图暂时不进仓库:现在这批带水印,每张约 3MB。等拿到无水印的正式导出再放开。
# (早先已经在仓库里的 5 张旧原图不受这条影响)
art_raw/*.png
art_raw/*.jpg
art_raw/*.jpeg
art_raw/*.webp

# 运行时产生的缓存
__pycache__/
*.pyc
node_modules/

# 系统文件
.DS_Store
Thumbs.db
